# Copy to .env and edit as needed. Every value here has a working default in
# scripts/lib/common.sh, so an empty .env is fine.
#
# .env is git-ignored because scripts/install.sh writes the generated admin
# password into it.

# --- Cluster / release ------------------------------------------------------
#CLUSTER_NAME=easy-local-airbyte
#NAMESPACE=airbyte
#RELEASE=airbyte

# Airbyte Helm chart (the "v2" chart line).
#CHART_VERSION=2.2.0

# http://localhost:<HOST_PORT> serves the UI. Change if 8000 is taken.
#HOST_PORT=8000

# --- Low-resource mode ------------------------------------------------------
# Equivalent of abctl's --low-resource-mode. See config/values/low-resource.yaml
# for exactly what it changes and why. Recommended true for local use.
LOW_RESOURCE_MODE=true

# Low-resource mode disables the connector-builder (manifest server) pod, as
# abctl does. Set false to keep the Connector Builder UI working.
DISABLE_CONNECTOR_BUILDER=true

# --- Docker VM (macOS) ------------------------------------------------------
# auto     use an existing Docker daemon if reachable, else the colima profile
# colima   always use the dedicated colima profile below
# existing use whatever `docker` currently points at, never manage a VM
#DOCKER_PROVIDER=auto

# A dedicated profile so your existing Docker setup is never resized or deleted.
#COLIMA_PROFILE=airbyte
#VM_CPUS=6
#VM_MEMORY_GIB=12
#VM_DISK_GIB=60

# --- Storage ----------------------------------------------------------------
# PVC size for the bundled Postgres. Applied at install time only; to grow an
# existing install, edit the PVC directly.
#PG_VOLUME_SIZE=10Gi

# Where backups are written.
#BACKUP_DIR=./backups

# --- Auth -------------------------------------------------------------------
# Generated and written here automatically on first install. Set it yourself to
# pin a known password instead.
AIRBYTE_ADMIN_PASSWORD=YourSuperSecurePassword

# Shown by `make credentials` only; Airbyte's initial email is set in the UI.
#AIRBYTE_ADMIN_EMAIL=

# --- Misc -------------------------------------------------------------------
#KIND_NODE_IMAGE=kindest/node:v1.33.1
#HELM_TIMEOUT=30m
